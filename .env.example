# NeuroBridge configuration (copy to .env)
# LLM assistance for question decomposition and the scientific-review narrative:
#   none      -> deterministic planner and rule-based reviewer (default; no key needed)
#   anthropic -> Claude via the Anthropic SDK (needs ANTHROPIC_API_KEY or an `ant auth login` profile)
# The LLM never produces numbers: every statistic in the app comes from executed code.
NEUROBRIDGE_LLM_PROVIDER=none
NEUROBRIDGE_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Data cache directory (default: <repo>/data/cache)
# NEUROBRIDGE_CACHE_DIR=
# Random seed for all stochastic steps
NEUROBRIDGE_SEED=20261109
# Allow network downloads (false = fully offline on cached data)
NEUROBRIDGE_ALLOW_NETWORK=true
